# Home network SSH mesh — every host below reaches every other host by
# alias, with key auth, from any machine on the LAN.
#
# This file is a chezmoi TEMPLATE and is shared by all four hosts. The
# github.com block is emitted on macOS ONLY: `UseKeychain` exists solely in
# Apple's OpenSSH fork, and stock Linux OpenSSH treats an unknown option as
# fatal for the ENTIRE file — one such line silently broke every outbound
# ssh from deathstar. Do not hoist it out of the conditional.
#
# Pending repurposing — deliberately NOT aliased until their new roles settle:
#   10.10.1.10   TV Mac (MacBookPro15,3), retired from HTPC duty
#   10.10.1.150  old NAS "asus", decommissioned
#   10.10.1.200  retropi, currently offline
# The old `plex` alias was removed: it pointed at the HA Pi on some hosts and
# at the dead NAS on others. Plex itself now runs on `foundation`.

Host stargazer
     HostName 10.10.1.19
     User jburgess

Host foundation
     HostName 10.10.1.20
     User jburgess

Host deathstar
     HostName 10.10.1.21
     User jburgess

Host ha
     HostName 10.10.1.100
     User pi

Host stargazer foundation deathstar ha
     IdentityFile ~/.ssh/id_ed25519
     ServerAliveInterval 60
     ServerAliveCountMax 3
{{ if eq .chezmoi.os "darwin" }}
Host github.com
     User git
     AddKeysToAgent yes
     UseKeychain yes
     IdentityFile ~/.ssh/id_ed25519

# 1Password SSH agent: previously set globally via
#   Host *
#     IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
# That socket does not exist — the agent is disabled in 1Password's settings, so
# the line was dead (and had been copied onto Linux hosts where it is meaningless).
# Re-enable it in 1Password > Developer > SSH Agent, then restore the block above.
{{ end -}}
